{
  "brand": {
    "name": "Scoutly",
    "site": "https://tiru67.github.io/scoutly-price-scout-privacy/",
    "audience": "Indian shoppers who want evidence-based electronics and buying advice",
    "voice": ["clear", "practical", "evidence-first", "non-hype"],
    "affiliateDisclosure": "Disclosure: this page contains an Amazon affiliate link."
  },
  "channels": {
    "linkedin": { "enabled": true, "autoPublish": false, "dailyLimit": 2 },
    "x": { "enabled": true, "autoPublish": false, "dailyLimit": 2 },
    "newsletter": { "enabled": true, "autoPublish": true, "weeklyLimit": 1 },
    "email": { "enabled": true, "autoPublish": true, "weeklyLimit": 1, "provider": "not_connected" },
    "communities": { "enabled": true, "autoPublish": false, "perCommunityWeeklyLimit": 1 },
    "shortVideo": { "enabled": true, "autoPublish": false, "weeklyLimit": 3 }
  },
  "analytics": {
    "primaryKpis": ["roi", "conversions", "affiliate_clicks", "qualified_visits", "email_signups"],
    "reviewCadence": "weekly",
    "minimumExperimentWindowDays": 7
  },
  "guardrails": {
    "requireApprovalBeforePublish": false,
    "maxPostsPerPlatformPerDay": 2,
    "pauseAfterConsecutiveWeakPeriods": 2,
    "neverInventLivePrices": true,
    "neverCreateArtificialEngagement": true
  }
